  "routes": [
    {
      "name": "Fate线",
      "endings": [
        {
          "name": "梦的延续",
          "type": "true",
          "steps": [
            {
              "type": "choice",
              "content": "2.去完成每天固定的修炼。"
            },
            {
              "type": "choice",
              "content": "2.去打工吧。"
            },
            {
              "type": "choice",
              "content": "2.和藤姐玩。"
            },
            {
              "type": "choice",
              "content": "2.阻止不了。【此选项要通过一次Fate线后才出现】"
            },
            {
              "type": "choice",
              "content": "2.参战。",
              "subfix": "（选“1.……放弃刻印。”则BAD END1）"
            },
            {
              "type": "choice",
              "content": "2.帮助Saber……！",
              "subfix": "（选“1.带着远坂逃跑……！”则BAD END2）"
            },
            {
              "type": "choice",
              "content": "2.那么从正题开始。"
            },
            {
              "type": "choice",
              "content": "1.……了解，联手吧。"
            },
            {
              "type": "choice",
              "content": "1.Saber是哪里的英雄呢？"
            },
            {
              "type": "choice",
              "content": "1.往远阪等候的地方去。"
            },
            {
              "type": "choice",
              "content": "3.关于Berserker。"
            },
            {
              "type": "choice",
              "content": "1.和Rider说话。"
            },
            {
              "type": "choice",
              "content": "2.不战斗。",
              "subfix": "（选“1.战斗。”则BAD END3）"
            },
            {
              "type": "choice",
              "content": "1.战斗的理由。想知道寻求圣杯的理由。"
            },
            {
              "type": "choice",
              "content": "1.想知道成为从者前的Saber。"
            },
            {
              "type": "save",
              "content": "SAVE1"
            },
            {
              "type": "note",
              "content": "若读取SAVE1并选择另一条路线（猴子也懂的必杀剑等），最终会进入BAD END13"
            },
            {
              "type": "choice",
              "content": "1.直接回卫宫宅。"
            },
            {
              "type": "choice",
              "content": "1.藤姐，土产呢？"
            },
            {
              "type": "choice",
              "content": "1.去叫远阪。"
            },
            {
              "type": "choice",
              "content": "1.没有阻止的必要……！"
            },
            {
              "type": "choice",
              "content": "2.……连战斗都称不上。",
              "subfix": "（选“1.在被打倒前先打倒……！”则BAD END4）"
            },
            {
              "type": "choice",
              "content": "1.召唤Saber……！",
              "subfix": "（选“3.不行，不能消耗令咒……！”则BAD END5）"
            },
            {
              "type": "choice",
              "content": "2.如果不追Saber的话……！",
              "subfix": "（选“1.……在这里等待。”则BAD END6）"
            },
            {
              "type": "choice",
              "content": "2.赶往Saber身边。"
            },
            {
              "type": "choice",
              "content": "2.……那件事，做不到。",
              "subfix": "（选“1.……如今只有点头了。”则BAD END7）"
            },
            {
              "type": "choice",
              "content": "2.……不是能战斗的状态。坐在椅子上，假装被绑住。"
            },
            {
              "type": "choice",
              "content": "1.在意Saber。"
            },
            {
              "type": "choice",
              "content": "1.用弓掩护……！"
            },
            {
              "type": "choice",
              "content": "2.———不要用！",
              "subfix": "（选“1.……除此之外，别无他法吗。”则BAD END8）"
            },
            {
              "type": "choice",
              "content": "1.把伊莉雅藏起来。"
            },
            {
              "type": "choice",
              "content": "1.好、来吃午餐吧。"
            },
            {
              "type": "choice",
              "content": "1.更详细地问投影魔术。"
            },
            {
              "type": "choice",
              "content": "2.和Saber两个人打出去。",
              "subfix": "（选“1.Caster就拜托Saber、这里我们两个人守住。”则BAD END9）"
            },
            {
              "type": "choice",
              "content": "1.相信远坂。",
              "subfix": "（选“2.Caster交给Saber。”则BAD END9）"
            },
            {
              "type": "choice",
              "content": "2.Saber，不行……！",
              "subfix": "（选“1.……那个空挡、抓住……！”则BAD END10）"
            },
            {
              "type": "choice",
              "content": "1.站起来。",
              "subfix": "（选“2.无法站起来。”则BAD END11）"
            },
            {
              "type": "choice",
              "content": "2.到地下室。",
              "subfix": "（选“1.回家。”则BAD END12）"
            },
            {
              "type": "choice",
              "content": "1.……尽管如此、远坂。"
            },
            {
              "type": "choice",
              "content": "3.……开作战会议。",
              "subfix": "（选“1.和Saber一起度过。”或“2.向切嗣报告。”则BAD END14）"
            },
            {
              "type": "choice",
              "content": "3.……把剑鞘还给Saber。",
              "subfix": "（选“1.寻找武器。”或“2.强化Saber。”则BAD END14）"
            }
          ]
        }
      ]
    },
