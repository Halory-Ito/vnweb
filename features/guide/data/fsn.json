    {
      "name": "Heavens Feel线",
      "endings": [
        {
          "name": "春天归来",
          "type": "true",
          "steps": [
            {
              "type": "choice",
              "content": "1.去帮忙樱做饭。"
            },
            {
              "type": "choice",
              "content": "2.去打工吧。"
            },
            {
              "type": "choice",
              "content": "1.去送樱一程。"
            },
            {
              "type": "choice",
              "content": "2.樱也要来说，再追加一道菜吧。"
            },
            {
              "type": "choice",
              "content": "2.在意樱。"
            },
            {
              "type": "choice",
              "content": "2.参战。",
              "subfix": "（选“1.……放弃刻印。”则BAD END1）"
            },
            {
              "type": "choice",
              "content": "2.帮助Saber……！",
              "subfix": "（选“1.带着远坂逃跑……！”则BAD END2）"
            },
            {
              "type": "choice",
              "content": "2.去新都。"
            },
            {
              "type": "choice",
              "content": "1.商量樱的事情。"
            },
            {
              "type": "choice",
              "content": "1.我并不讨厌你喔。"
            },
            {
              "type": "choice",
              "content": "2.自己来说。"
            },
            {
              "type": "choice",
              "content": "1.去看一下的好……？"
            },
            {
              "type": "choice",
              "content": "2.敷衍过去。"
            },
            {
              "type": "choice",
              "content": "1.外出购物。"
            },
            {
              "type": "save",
              "content": "SAVE3"
            },
            {
              "type": "note",
              "content": "若读取SAVE3后选择“3.饭后看电视。”等，可能进入BAD END25或26"
            },
            {
              "type": "choice",
              "content": "2.忍耐。"
            },
            {
              "type": "choice",
              "content": "3.……不、担心樱。"
            },
            {
              "type": "choice",
              "content": "2.我抱着前来谢罪的诚意，请听我说句话。"
            },
            {
              "type": "choice",
              "content": "1.调查柳洞寺。"
            },
            {
              "type": "choice",
              "content": "1.相信Saber而等着……！或3.使用令咒……！",
              "subfix": "（选“2.朝臓砚砍下……！”则BAD END27）"
            },
            {
              "type": "choice",
              "content": "1.老家伙游刃有余、对吧？"
            },
            {
              "type": "choice",
              "content": "2.我一个人行不通。得向远坂借力。",
              "subfix": "（选“1.……不、这是我个人的问题。”则BAD END28）"
            },
            {
              "type": "choice",
              "content": "1.是。"
            },
            {
              "type": "choice",
              "content": "1.可以。"
            },
            {
              "type": "choice",
              "content": "1.谁办得到啊！"
            },
            {
              "type": "save",
              "content": "SAVE4"
            },
            {
              "type": "note",
              "content": "若读取SAVE4后选择“2.……没办法。”，后续可能进入BAD END31"
            },
            {
              "type": "choice",
              "content": "1.不、不能再让樱一个人待在家里。"
            },
            {
              "type": "choice",
              "content": "1.去拉开远坂———",
              "subfix": "（选“2.闭上眼睛、朝Rider砍下———”则BAD END29）"
            },
            {
              "type": "choice",
              "content": "2.我想做樱的保护者。",
              "subfix": "（选“1.……我要，坚持正义之士的道路。”则BAD END30）"
            },
            {
              "type": "choice",
              "content": "3.对了Rider，你不吃吗？"
            },
            {
              "type": "choice",
              "content": "2.赶快过去看看，",
              "subfix": "（选“1.……留在原地。”则BAD END32）"
            },
            {
              "type": "choice",
              "content": "2.坚守伊莉雅……！",
              "subfix": "（选“1.拉回远坂……！”则BAD END33）"
            },
            {
              "type": "choice",
              "content": "2.伊莉雅、吧？"
            },
            {
              "type": "choice",
              "content": "2.不解开。"
            },
            {
              "type": "choice",
              "content": "3.不，探望樱是第一优先。"
            },
            {
              "type": "choice",
              "content": "1.……上下点头。"
            },
            {
              "type": "choice",
              "content": "1.接受。",
              "subfix": "（选“2.不接受。”则BAD END34）"
            },
            {
              "type": "choice",
              "content": "2.……只有这件事，办不到。",
              "subfix": "（选“1.亲自下手。”则BAD END35）"
            },
            {
              "type": "choice",
              "content": "1.急忙赶回家中。"
            },
            {
              "type": "choice",
              "content": "1.救出樱。带回伊莉雅。",
              "subfix": "（选“2.我们输了。”则BAD END36）"
            },
            {
              "type": "choice",
              "content": "2.点头。",
              "subfix": "（选“1.拒绝。”则BAD END37）"
            },
            {
              "type": "choice",
              "content": "1./2./3.带走伊莉雅。"
            },
            {
              "type": "choice",
              "content": "3.……回答之前的问题。",
              "subfix": "（选“1.逃到仓库外面……！”或“2.投影抵抗……！”则BAD END38）"
            },
            {
              "type": "choice",
              "content": "3.“站在樱那边到最后一刻吗”",
              "subfix": "（选“1.“奋战到最后吗””或“2.“坚持到最后吗””则BAD END38）"
            },
            {
              "type": "choice",
              "content": "3.等待机会……！",
              "subfix": "（选“1.和Saber对打……！”则BAD END39）"
            },
            {
              "type": "save",
              "content": "SAVE5"
            },
